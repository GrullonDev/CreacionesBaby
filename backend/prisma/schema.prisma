generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  ADMIN
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  orders         Order[]
  recordedSales  Order[]         @relation("RecordedSales")
  stockMovements StockMovement[]
  financeEntries FinanceEntry[]
}

model Product {
  id            String         @id @default(cuid())
  name          String
  category      String
  subcategory   String?
  brand         String?
  price         Decimal        @db.Decimal(10, 2)
  originalPrice Decimal?       @db.Decimal(10, 2)
  // Unit cost of goods. Optional because the catalog predates it and imported
  // products may not have it. Never exposed on the public storefront payload —
  // see `toSellerProduct` vs `toStorefrontProduct` in routes/products.js.
  cost          Decimal?       @db.Decimal(10, 2)
  description   String
  rating        Float          @default(0)
  reviews       Int            @default(0)
  features      String[]       @default([])
  inStock       Boolean        @default(true)
  stock         Int            @default(0)
  colors        String[]       @default([])
  sizes         String[]       @default([])
  images        ProductImage[]
  sellerId      String?
  seller        User?          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  movements     StockMovement[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([category])
  @@index([sellerId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Where a sale came from. WEB is a storefront checkout; everything else is a
/// sale recorded by hand in the back office (WhatsApp, in person, a fair...).
enum SaleChannel {
  WEB
  WHATSAPP
  PRESENCIAL
  FERIA
  REDES
  OTRO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CONTRA_ENTREGA
  OTRO
}

/// An `Order` is a *sale*, whether it came from web checkout or was entered by
/// hand in the back office (see `channel`). One table so "all sales" is one
/// query, not a union.
model Order {
  id       String        @id @default(cuid())
  // Nullable: orders can be placed as a guest (no customer account exists yet
  // on the storefront). Set only if a valid JWT was presented at checkout.
  userId   String?
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status   OrderStatus   @default(PENDING)
  channel  SaleChannel   @default(WEB)
  total    Decimal       @db.Decimal(10, 2)
  discount Decimal       @default(0) @db.Decimal(10, 2)
  shipping Decimal       @default(0) @db.Decimal(10, 2)

  promoCode     String?
  paymentMethod PaymentMethod?

  // The business date of the sale, distinct from `createdAt` (the row's
  // insertion time) so a sale from last week can be entered today and still
  // land in the right reporting period. All reports group by this.
  soldAt DateTime @default(now())

  // Shipping/contact snapshot at time of purchase (not linked to a live Address
  // record). All nullable: a cash sale at a fair has no shipping address, and
  // may not even have a customer name. `POST /orders` (web checkout) still
  // requires them at the Zod layer.
  addressName   String?
  addressEmail  String?
  addressLine   String?
  addressCity   String?
  addressZip    String?
  customerPhone String?

  notes String?

  // Who entered this sale in the back office. Distinct from `userId`, which is
  // the *buyer* when a logged-in customer places the order.
  recordedById String?
  recordedBy   User?   @relation("RecordedSales", fields: [recordedById], references: [id], onDelete: SetNull)

  items     OrderItem[]
  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([channel])
  @@index([soldAt])
  @@index([recordedById])
  @@index([status])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int
  price         Decimal @db.Decimal(10, 2)
  // Unit cost snapshotted at sale time so historical gross margin stays correct
  // when the product's cost later changes.
  cost          Decimal? @db.Decimal(10, 2)
  selectedColor String?
  selectedSize  String?
}

/// Why stock moved. `quantity` on the movement is a signed delta, so ENTRADA /
/// DEVOLUCION are positive and VENTA / SALIDA / MERMA are negative; AJUSTE can
/// be either (it records the delta needed to reach a counted total).
enum StockMovementType {
  ENTRADA
  SALIDA
  VENTA
  DEVOLUCION
  AJUSTE
  MERMA
}

model StockMovement {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       StockMovementType
  /// Signed delta applied to Product.stock.
  quantity   Int
  /// Product.stock *after* this movement was applied, so history is readable
  /// without replaying every prior row.
  stockAfter Int
  reason     String?
  unitCost   Decimal?          @db.Decimal(10, 2)
  /// Set when this movement was generated by a sale (or its cancellation).
  orderId    String?
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([type])
  @@index([orderId])
}

enum EntryDirection {
  INGRESO
  EGRESO
}

/// Categories for cash movements that are *not* product sales (sales revenue
/// lives in `Order`). EGRESO categories first, then INGRESO ones — the API
/// validates that the category matches the entry's direction.
enum FinanceCategory {
  MATERIA_PRIMA
  INVENTARIO
  ENVIO
  EMPAQUE
  PUBLICIDAD
  SERVICIOS
  RENTA
  SALARIOS
  COMISIONES
  IMPUESTOS
  EQUIPO
  OTRO_EGRESO
  APORTE_CAPITAL
  PRESTAMO
  REEMBOLSO_PROVEEDOR
  OTRO_INGRESO
}

/// A single line in the cash ledger: money in that isn't a product sale, or
/// money out. One table for both directions keeps the cash summary one query.
model FinanceEntry {
  id            String          @id @default(cuid())
  direction     EntryDirection
  category      FinanceCategory
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  /// Proveedor or cliente this movement is with.
  counterparty  String?
  /// Invoice / factura / receipt number.
  reference     String?
  receiptUrl    String?
  notes         String?
  /// Business date of the movement (backdatable), distinct from createdAt.
  occurredAt    DateTime        @default(now())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([occurredAt])
  @@index([direction])
  @@index([category])
}
