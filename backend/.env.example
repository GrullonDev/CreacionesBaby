# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/creaciones_baby?schema=public"

# Fastify server
PORT=4000

# Comma-separated list of allowed origins for CORS (Vite dev server default shown)
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign JWT auth tokens - use a long random value in production
JWT_SECRET="change-me"
