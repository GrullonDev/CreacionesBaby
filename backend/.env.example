# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/creaciones_baby?schema=public"

# Fastify server
PORT=4000

# Allowed origins for CORS, comma-separated. Only the admin app talks to this API
# now that the storefront is gone, so in development that's a single origin.
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign JWT auth tokens - use a long random value in production
# (`openssl rand -base64 48`). Never ship "change-me".
JWT_SECRET="change-me"

# Optional — only read by `npm run seed:admin`, which creates or promotes the
# operator account. There is no self-service way to become ADMIN through the API,
# and no sample-data seed: this is a real inventory system, so every product in it
# should be one you actually own.
# ADMIN_EMAIL="admin@creacionesbaby.test"
# ADMIN_PASSWORD="admin12345"
