# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/creaciones_baby?schema=public"

# Fastify server
PORT=4000

# Comma-separated list of allowed origins for CORS (storefront + seller-portal Vite dev servers)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Secret used to sign JWT auth tokens - use a long random value in production
JWT_SECRET="change-me"
