# Copy to .env and fill in real values. Vite only exposes variables prefixed with VITE_.

# WhatsApp number for the floating chat button, in international format with no
# leading + or spaces (e.g. Guatemala: 502XXXXXXXX). Falls back to a placeholder if unset.
VITE_WHATSAPP_NUMBER=50200000000

# Real product API base URL. If unset, the app uses local mock data (src/data/products.js).
VITE_API_URL=
